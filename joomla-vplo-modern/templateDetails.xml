<?xml version="1.0" encoding="utf-8"?>
<extension type="template" client="site" method="upgrade">
  <name>tpl_vplo_modern</name>
  <version>1.6.0</version>
  <creationDate>2026-09-16</creationDate>
  <author>DBLaboffice</author>
  <copyright>(C) 2026 V Prywatne Liceum Ogólnokształcące</copyright>
  <license>GNU General Public License version 2 or later</license>
  <authorEmail>dyrektor@vp-lo.krakow.pl</authorEmail>
  <authorUrl>https://vp-lo.krakow.pl</authorUrl>
  <description>Szablon Joomla 6 dla V Prywatnego Liceum Ogólnokształcącego w Krakowie.</description>
  <inheritable>0</inheritable>
  <files>
    <filename>index.php</filename>
    <filename>component.php</filename>
    <filename>error.php</filename>
    <filename>templateDetails.xml</filename>
    <filename>README-PL.md</filename>
    <filename>home.php</filename>
    <folder>html</folder>
  </files>
  <media destination="templates/site/tpl_vplo_modern" folder="media">
    <folder>css</folder>
    <folder>js</folder>
    <folder>images</folder>
  </media>
  <positions>
    <position>main-menu</position>
    <position>header-actions</position>
    <position>header-banner</position>
    <position>footer-school</position>
    <position>footer-contact</position>
    <position>footer-nav</position>
    <position>footer-credit</position>
    <position>home-updates</position>
    <position>home-values</position>
    <position>home-patron</position>
    <position>home-students</position>
    <position>home-sections</position>
    <position>home-links</position>
  </positions>
  <config>
    <fields name="params">
      <fieldset name="basic" label="Ustawienia szablonu">
        <field name="banner_image" type="media" label="Obraz banera nagłówka" directory="images" default="images/smolensk-siedziba.png" />
      </fieldset>
    </fields>
  </config>
</extension>
